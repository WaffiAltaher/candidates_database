# Copy this to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit secrets.

anthropic_api_key    = "sk-ant-..."
auth_secret          = "some-random-secret-string"
auth_users           = "{\"admin\":\"<sha256-of-password>\"}"
allowed_origin       = "https://cv.yourdomain.com"
frontend_bucket_name = "candidates-db-frontend"
